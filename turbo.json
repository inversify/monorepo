{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{cts,mts,ts,tsx}"],
      "outputs": ["dist/**", "lib/**"]
    },
    "@inversifyjs/binding-decorators-code-examples#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{cts,mts,ts}"],
      "outputs": ["generated/**", "lib/**"]
    },
    "@inversifyjs/react-code-runner#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{css,cts,mts,ts,tsx}", "vite.config.ts"],
      "outputs": ["generated/**", "lib/**"]
    },
    "@inversifyjs/code-examples#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{cts,mts,ts}"],
      "outputs": ["generated/**", "lib/**"]
    },
    "@inversifyjs/graphql-code-examples#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{cts,mts,ts}"],
      "outputs": ["generated/**", "lib/**"]
    },
    "@inversifyjs/http-code-examples#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{cts,mts,ts}"],
      "outputs": ["generated/**", "lib/**"]
    },
    "@inversifyjs/http-open-api-code-examples#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{cts,mts,ts}"],
      "outputs": ["generated/**", "lib/**"]
    },
    "@inversifyjs/config-code-examples#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{cts,mts,ts}"],
      "outputs": ["generated/**", "lib/**"]
    },
    "@inversifyjs/db-code-examples#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "prisma/**",
        "prisma.config.ts",
        "src/**/*.{cts,mts,ts}",
        "tsconfig.json",
        "tsconfig.esm.json"
      ],
      "outputs": ["generated/**", "lib/**", "src/generated/**"]
    },
    "@inversifyjs/db-code-examples#lint": {
      "dependsOn": ["build"],
      "inputs": [
        "eslint.config.{cjs,mjs,js,json}",
        "prisma/**",
        "prisma.config.ts",
        "src/**/*.{cts,mts,ts}"
      ]
    },
    "@inversifyjs/db-code-examples#test": {
      "dependsOn": ["build"],
      "inputs": [
        "prisma/**",
        "prisma.config.ts",
        "src/**/*.{cts,mts,ts}"
      ],
      "outputs": []
    },
    "@inversifyjs/db-code-examples#test:unit": {
      "dependsOn": ["build"],
      "inputs": [
        "prisma/**",
        "prisma.config.ts",
        "src/**/*.{cts,mts,ts}"
      ],
      "outputs": []
    },
    "@inversifyjs/db-code-examples#test:integration": {
      "dependsOn": ["build"],
      "inputs": [
        "prisma/**",
        "prisma.config.ts",
        "src/**/*.{cts,mts,ts}"
      ],
      "outputs": []
    },
    "@inversifyjs/db-code-examples#test:coverage": {
      "dependsOn": ["build"],
      "inputs": [
        "prisma/**",
        "prisma.config.ts",
        "src/**/*.{cts,mts,ts}"
      ],
      "outputs": ["coverage/**"]
    },
    "@inversifyjs/db-code-examples#test:uncommitted": {
      "dependsOn": ["build"],
      "inputs": [
        "prisma/**",
        "prisma.config.ts",
        "src/**/*.{cts,mts,ts}"
      ],
      "outputs": []
    },
    "@inversifyjs/logger-code-examples#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{cts,mts,ts}"],
      "outputs": ["generated/**", "lib/**"]
    },
    "@inversifyjs/validation-code-examples#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{cts,mts,ts}"],
      "outputs": ["generated/**", "lib/**"]
    },
    "@inversifyjs/framework-docs-site#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "blog/**",
        "config-docs/**",
        "db-docs/**",
        "docs/**",
        "graphql-docs/**",
        "logger-docs/**",
        "openapi-docs/**",
        "src/**/*.{css,cts,mts,ts,tsx}",
        "static/**",
        "docusaurus.config.ts",
        "sidebars.ts",
        "sidebarsDb.ts",
        "validation-docs/**",
        "versioned_docs/**",
        "versioned_sidebars/**"
      ],
      "outputs": ["build/**"]
    },
    "@inversifyjs/inversify-binding-decorators-docs-site#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "blog/**",
        "docs/**",
        "src/**/*.{css,cts,mts,ts,tsx}",
        "static/**",
        "docusaurus.config.ts",
        "sidebars.ts",
        "versioned_docs/**",
        "versioned_sidebars/**"
      ],
      "outputs": ["build/**"]
    },
    "@inversifyjs/inversify-docs-site#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "blog/**",
        "docs/**",
        "i18n/**",
        "src/**/*.{css,cts,mts,ts,tsx}",
        "static/**",
        "docusaurus.config.ts",
        "sidebars.ts",
        "versioned_docs/**",
        "versioned_sidebars/**"
      ],
      "outputs": ["build/**"]
    },
    "format": {
      "inputs": ["src/**/*.{cts,mts,ts}", "prettier.config.{cjs,mjs,js,json}"],
      "outputs": ["src/**/*.{cts,mts,ts}"]
    },
    "@inversifyjs/foundation-vitest-config#format": {
      "inputs": ["lib/**/*.{cjs,mjs,js}", "prettier.config.{cjs,mjs,js,json}"],
      "outputs": ["lib/**/*.{cjs,mjs,js}"]
    },
    "@inversifyjs/foundation-rollup-config#format": {
      "inputs": ["lib/**/*.{cjs,mjs,js}", "prettier.config.{cjs,mjs,js,json}"],
      "outputs": ["lib/**/*.{cjs,mjs,js}"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{cts,mts,ts}", "eslint.config.{cjs,mjs,js,json}"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{cts,mts,ts}"],
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:e2e:cjs": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "test:e2e:esm": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{cts,mts,ts}"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{cts,mts,ts}"],
      "outputs": ["coverage/**"]
    },
    "test:mutation": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{cts,mts,ts}"],
      "outputs": ["reports/**"]
    },
    "test:uncommitted": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{cts,mts,ts}"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{cts,mts,ts}"],
      "outputs": []
    }
  },
  "ui": "tui"
}
