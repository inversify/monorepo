{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "InversifyJS",
  "colors": {
    "primary": "#0066CC",
    "light": "#0084FF",
    "dark": "#004099"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "pages": [
          "docs/introduction/getting-started",
          "docs/introduction/dependency-inversion"
        ]
      },
      {
        "group": "Fundamentals",
        "pages": [
          "docs/fundamentals/di-hierarchy",
          "docs/fundamentals/binding",
          "docs/fundamentals/inheritance",
          "docs/fundamentals/lifecycle/activation",
          "docs/fundamentals/lifecycle/deactivation",
          "docs/fundamentals/snapshot",
          "docs/fundamentals/plugins"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "docs/guides/migrating-from-v7",
          "docs/guides/migrating-from-v6"
        ]
      },
      {
        "group": "FAQ",
        "pages": [
          "docs/faq/requirements",
          "docs/faq/using-bundlers"
        ]
      },
      {
        "group": "Ecosystem",
        "pages": [
          "docs/ecosystem/framework",
          "docs/ecosystem/binding-decorators",
          "docs/ecosystem/strongly-typed",
          "docs/ecosystem/suites"
        ]
      },
      {
        "group": "Internals",
        "pages": [
          "docs/internals/planning"
        ]
      },
      {
        "group": "API Reference",
        "pages": [
          "docs/api/binding-syntax",
          "docs/api/container",
          "docs/api/lazy-service-identifier",
          "docs/api/decorate",
          "docs/api/service-identifier",
          "docs/api/decorator",
          "docs/api/container-module"
        ]
      }
    ]
  },
  "logo": {
    "light": "/static/img/logo.svg",
    "dark": "/static/img/logo.svg"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#080A11"
    }
  },
  "navbar": {
    "version": {
      "mode": "multi",
      "choices": [
        {
          "version": "8.x (Latest)",
          "path": "/"
        },
        {
          "version": "7.x",
          "path": "/versioned_docs/version-7.x/"
        },
        {
          "version": "6.x",
          "path": "/versioned_docs/version-6.x/"
        }
      ]
    },
    "links": [
      {
        "label": "Discord",
        "href": "https://discord.gg/jXcMagAPnm"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/inversify/monorepo"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://github.com/inversify/monorepo"
    }
  },
  "seo": {
    "metatags": {
      "og:image": "https://mintlify.com/og-image.png",
      "og:description": "A powerful and lightweight inversion of control container for JavaScript & Node.js apps powered by TypeScript"
    },
    "indexing": "navigable"
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/jXcMagAPnm",
      "github": "https://github.com/inversify/monorepo",
      "twitter": "https://twitter.com/inversifyjs"
    }
  }
}
