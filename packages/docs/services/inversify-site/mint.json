{
  "$schema": "https://mintlify.com/schema.json",
  "name": "InversifyJS",
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "favicon": "/favicon.ico",
  "colors": {
    "primary": "#0066CC",
    "light": "#0084FF",
    "dark": "#004099",
    "ultraLight": "#EBEBF0",
    "ultraDark": "#080A11",
    "background": {
      "light": "#FFFFFF",
      "dark": "#080A11"
    }
  },
  "modeToggle": {
    "default": "dark",
    "isHidden": false
  },
  "theme": "venus",
  "topbarLinks": [
    {
      "name": "Discord",
      "url": "https://discord.gg/jXcMagAPnm"
    },
    {
      "name": "GitHub",
      "url": "https://github.com/inversify/monorepo"
    }
  ],
  "topbarCtaButton": {
