{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "InversifyJS",
  "colors": {
    "primary": "#0066CC",
    "light": "#0084FF",
    "dark": "#004099"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction/getting-started",
              "introduction/dependency-inversion"
            ]
          },
          {
            "group": "Fundamentals",
            "pages": [
              "fundamentals/di-hierarchy",
              "fundamentals/binding",
              "fundamentals/inheritance",
              "fundamentals/lifecycle/activation",
              "fundamentals/lifecycle/deactivation",
              "fundamentals/snapshot",
              "fundamentals/plugins"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/migrating-from-v7",
              "guides/migrating-from-v6"
            ]
          },
          {
            "group": "FAQ",
            "pages": [
              "faq/requirements",
              "faq/using-bundlers"
            ]
          },
          {
            "group": "Ecosystem",
            "pages": [
              "ecosystem/framework",
              "ecosystem/binding-decorators",
              "ecosystem/strongly-typed",
              "ecosystem/suites"
            ]
          },
          {
            "group": "Internals",
            "pages": [
              "internals/planning"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "pages": [
              "api/binding-syntax",
              "api/container",
              "api/decorators",
              "api/interfaces"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#080A11"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Discord",
        "href": "https://discord.gg/jXcMagAPnm"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/inversify/monorepo"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://github.com/inversify/monorepo"
    }
  },
  "seo": {
    "metatags": {
      "og:image": "https://mintlify.com/og-image.png",
      "og:description": "A powerful and lightweight inversion of control container for JavaScript & Node.js apps powered by TypeScript"
    },
    "indexing": "navigable"
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/jXcMagAPnm",
      "github": "https://github.com/inversify/monorepo",
      "twitter": "https://twitter.com/inversifyjs"
    }
  }
}