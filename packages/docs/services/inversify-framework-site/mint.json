{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Inversify Framework",
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "favicon": "/favicon.ico",
  "colors": {
    "primary": "#0066CC",
    "light": "#0084FF",
    "dark": "#004099",
    "ultraLight": "#EBEBF0",
    "ultraDark": "#080A11",
    "background": {
      "light": "#FFFFFF",
      "dark": "#080A11"
    }
  },
  "modeToggle": {
    "default": "dark",
    "isHidden": false
  },
  "theme": "mintlify",
  "topbarLinks": [
    {
      "name": "Discord",
      "url": "https://discord.gg/jXcMagAPnm"
    },
    {
      "name": "GitHub",
      "url": "https://github.com/inversify/monorepo"
    }
  ],
  "topbarCtaButton": {
    "name": "Get Started",
    "url": "https://github.com/inversify/monorepo"
  },
  "tabs": [
    {
      "name": "HTTP",
      "url": "docs",
      "isDefaultTab": true
    },
    {
      "name": "Config",
      "url": "config"
    },
    {
      "name": "Database",
      "url": "db"
    },
    {
      "name": "GraphQL",
      "url": "graphql"
    },
    {
      "name": "Logger",
      "url": "logger"
    },
    {
      "name": "OpenAPI",
      "url": "openapi"
    },
    {
      "name": "Validation",
      "url": "validation"
    }
  ],
  "navigation": [
    {
      "group": "Get Started",
      "pages": [
        "introduction/getting-started"
      ]
    },
    {
      "group": "Core Concepts",
      "pages": [
        "fundamentals/middleware",
        "fundamentals/routing",
        "fundamentals/controllers"
      ]
    },
    {
      "group": "API Reference",
      "pages": [
        "api/decorators",
        "api/http-server"
      ]
    },
    {
      "group": "Examples",
      "pages": [
        "examples/basic-server",
        "examples/advanced-patterns"
      ]
    }
  ],
  "footerSocials": {
    "discord": "https://discord.gg/jXcMagAPnm",
    "github": "https://github.com/inversify/monorepo",
    "twitter": "https://twitter.com/inversifyjs"
  },
  "metadata": {
    "og:image": "https://mintlify.com/og-image.png",
    "og:description": "A powerful set of tools to create HTTP APIs on top of InversifyJS"
  }
}
