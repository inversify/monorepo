{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/inversify/monorepo/issues"
  },
  "description": "InversifyJS HTTP docs code examples package",
  "devDependencies": {
    "@fastify/multipart": "10.1.7",
    "@hono/node-server": "2.1.6",
    "@inversifyjs/code-examples-devkit": "workspace:*",
    "@inversifyjs/foundation-oxfmt-config": "workspace:*",
    "@inversifyjs/foundation-oxlint-config": "workspace:*",
    "@inversifyjs/http-better-auth": "workspace:*",
    "@inversifyjs/http-core": "workspace:*",
    "@inversifyjs/http-express": "workspace:*",
    "@inversifyjs/http-fastify": "workspace:*",
    "@inversifyjs/http-hono": "workspace:*",
    "@inversifyjs/http-insights": "workspace:*",
    "@inversifyjs/http-sse": "workspace:*",
    "@inversifyjs/http-uwebsockets": "workspace:*",
    "@inversifyjs/logger": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "better-auth": "1.7.18",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "fastify": "5.12.8",
    "glob": "14.0.4",
    "hono": "4.13.17",
    "inversify": "8.3.0",
    "multer": "2.5.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "rimraf": "6.1.4",
    "typescript": "7.0.2",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.70.0",
    "vitest": "5.1.0"
  },
  "homepage": "https://inversify.io",
  "devEngines": {
    "node": "^26.0.0",
    "pnpm": "^12.0.0"
  },
  "license": "MIT",
  "name": "@inversifyjs/http-code-examples",
  "type": "module",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inversify/monorepo.git"
  },
  "scripts": {
    "build": "tsc && pnpm run generate:examples",
    "build:clean": "rimraf generated lib",
    "format": "oxfmt --write ./src",
    "generate:examples": "node ./lib/scripts/generateExamples/index.js",
    "lint": "oxlint ./src",
    "prebuild": "pnpm run build:clean",
    "test": "vitest run",
    "test:integration": "pnpm run test --project Integration",
    "test:coverage": "pnpm run test:unit --coverage",
    "test:uncommitted": "pnpm run test --changed=HEAD",
    "test:unit": "pnpm run test --project Unit"
  }
}
