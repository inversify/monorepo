{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/inversify/monorepo/issues"
  },
  "description": "InversifyJs GraphQL docs code examples package",
  "devDependencies": {
    "@inversifyjs/apollo-core": "0.7.2",
    "@inversifyjs/apollo-express": "0.8.2",
    "@inversifyjs/code-examples-devkit": "workspace:*",
    "@inversifyjs/foundation-oxfmt-config": "workspace:*",
    "@inversifyjs/foundation-oxlint-config": "workspace:*",
    "@inversifyjs/http-core": "5.9.1",
    "@inversifyjs/http-express": "5.9.1",
    "@apollo/server": "5.5.1",
    "@apollo/subgraph": "2.15.1",
    "@graphql-tools/utils": "13.2.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "fastify": "5.12.8",
    "glob": "14.0.3",
    "inversify": "8.2.4",
    "mercurius": "16.12.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "homepage": "https://inversify.io",
  "keywords": [
    "dependency injection",
    "dependency inversion",
    "di",
    "inversion of control container",
    "ioc",
    "javascript",
    "node",
    "typescript"
  ],
  "devEngines": {
    "node": "^26.0.0",
    "pnpm": "^12.0.0"
  },
  "license": "MIT",
  "name": "@inversifyjs/graphql-code-examples",
  "type": "module",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inversify/monorepo.git"
  },
  "scripts": {
    "build": "tsc && pnpm run generate:examples",
    "build:clean": "rimraf generated lib",
    "format": "oxfmt --write ./src",
    "generate:examples": "node ./lib/scripts/generateExamples/index.js",
    "lint": "oxlint ./src",
    "prebuild": "pnpm run build:clean",
    "test": "vitest run",
    "test:integration": "pnpm run test --project Integration",
    "test:coverage": "pnpm run test:unit --coverage",
    "test:uncommitted": "pnpm run test --changed=HEAD",
    "test:unit": "pnpm run test --project Unit"
  }
}
