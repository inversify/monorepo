{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/inversify/monorepo/issues"
  },
  "description": "InversifyJS gRPC docs code examples package",
  "devDependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@grpc/grpc-js": "1.14.7",
    "@grpc/proto-loader": "0.8.1",
    "@inversifyjs/code-examples-devkit": "workspace:*",
    "@inversifyjs/foundation-oxfmt-config": "workspace:*",
    "@inversifyjs/foundation-oxlint-config": "workspace:*",
    "@inversifyjs/grpc-core": "workspace:*",
    "@inversifyjs/grpc-js": "workspace:*",
    "@inversifyjs/logger": "workspace:*",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "glob": "14.0.4",
    "grpc-tools": "1.13.1",
    "inversify": "8.3.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.4",
    "ts-proto": "2.18.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "homepage": "https://inversify.io",
  "keywords": [
    "dependency injection",
    "dependency inversion",
    "di",
    "grpc",
    "inversion of control container",
    "ioc",
    "javascript",
    "node",
    "typescript"
  ],
  "devEngines": {
    "node": "^26.0.0",
    "pnpm": "^12.0.0"
  },
  "license": "MIT",
  "name": "@inversifyjs/grpc-code-examples",
  "type": "module",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inversify/monorepo.git"
  },
  "scripts": {
    "build": "tsc && pnpm run generate:examples",
    "build:clean": "rimraf generated lib",
    "format": "oxfmt --write ./src",
    "generate:examples": "node ./lib/scripts/generateExamples/index.js",
    "proto:generate": "mkdir -p ./src/examples/v1/generated && grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/examples/v1/generated --ts_proto_opt=esModuleInterop=true,importSuffix=.js,outputServices=grpc-js,env=node,useOptionals=none,outputJsonMethods=false,outputClientImpl=false --proto_path=./src/examples/v1 ./src/examples/v1/hero.proto && oxfmt --write ./src/examples/v1/generated/hero.ts",
    "lint": "oxlint ./src",
    "prebuild": "pnpm run build:clean",
    "test": "vitest run",
    "test:integration": "pnpm run test --project Integration",
    "test:coverage": "pnpm run test:unit --coverage",
    "test:uncommitted": "pnpm run test --changed=HEAD",
    "test:unit": "pnpm run test --project Unit"
  }
}
