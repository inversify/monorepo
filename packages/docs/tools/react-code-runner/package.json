{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/inversify/monorepo/issues"
  },
  "description": "InversifyJS bundles package",
  "devDependencies": {
    "@babel/types": "7.29.11",
    "@inversifyjs/common": "workspace:*",
    "@inversifyjs/container": "workspace:*",
    "@inversifyjs/core": "workspace:*",
    "@inversifyjs/foundation-oxfmt-config": "workspace:*",
    "@inversifyjs/foundation-oxlint-config": "workspace:*",
    "@inversifyjs/plugin": "0.3.2",
    "@microsoft/api-extractor": "7.60.1",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@rollup/plugin-typescript": "12.3.1",
    "@types/babel__core": "7.20.5",
    "@types/babel__standalone": "7.1.9",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "glob": "14.0.4",
    "inversify": "8.3.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "rimraf": "6.1.4",
    "rollup": "4.67.5",
    "ts-loader": "9.6.2",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "unplugin-dts": "1.1.2",
    "vite": "8.3.6",
    "vite-plugin-lib-inject-css": "2.2.2"
  },
  "peerDependencies": {
    "@babel/standalone": "^7.29.7",
    "@swc/wasm-web": "^1.16.22",
    "monaco-editor": "~0.57.0",
    "react": "19.3.1"
  },
  "homepage": "https://inversify.io",
  "devEngines": {
    "node": "^26.0.0",
    "pnpm": "^12.0.0"
  },
  "license": "MIT",
  "exports": {
    ".": "./lib/esm/index.js",
    "./InversifyCodeEditor": "./lib/esm/components/InversifyCodeEditor/index.js",
    "./inversifyBundle.js": "./lib/esm/inversifyBundle.js",
    "./generated/types.d.ts.txt": "./generated/types.d.ts.txt"
  },
  "name": "@inversifyjs/react-code-runner",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inversify/monorepo.git"
  },
  "scripts": {
    "build": "pnpm run types:check && pnpm run build:esm",
    "build:esm": "rollup -c ./bundle.rollup.config.mjs && pnpm run bundle:types:esm && vite build",
    "build:clean": "rimraf generated lib",
    "bundle:types:esm": "pnpm exec api-extractor run --local --verbose",
    "format": "oxfmt --write ./src",
    "lint": "oxlint ./src",
    "prebuild": "pnpm run build:clean",
    "types:check": "tsc --noEmit"
  },
  "type": "module"
}
