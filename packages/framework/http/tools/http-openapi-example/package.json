{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/inversify/monorepo/issues"
  },
  "description": "InversifyJs HTTP OpenAPI example package",
  "dependencies": {
    "@inversifyjs/http-core": "workspace:*",
    "@inversifyjs/http-express": "workspace:*",
    "@inversifyjs/http-insights": "workspace:*",
    "@inversifyjs/http-open-api": "workspace:*",
    "@inversifyjs/http-validation": "workspace:*",
    "@inversifyjs/open-api-validation": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.3.0",
    "inversify": "8.2.3",
    "lmdb": "3.5.8"
  },
  "devDependencies": {
    "@inversifyjs/foundation-oxfmt-config": "workspace:*",
    "@inversifyjs/foundation-oxlint-config": "workspace:*",
    "@inversifyjs/open-api-types": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "24.19.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "node": "^24.10.0",
    "pnpm": "^12.0.0"
  },
  "homepage": "https://inversify.io",
  "keywords": [
    "dependency injection",
    "dependency inversion",
    "di",
    "inversion of control container",
    "ioc",
    "javascript",
    "node",
    "typescript"
  ],
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js"
  },
  "name": "@inversifyjs/http-openapi-example",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inversify/monorepo.git"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rimraf lib",
    "format": "oxfmt --write ./src",
    "lint": "oxlint ./src",
    "prebuild": "pnpm run build:clean",
    "serve": "node ./lib/index.js"
  },
  "type": "module",
  "version": "1.0.0"
}
