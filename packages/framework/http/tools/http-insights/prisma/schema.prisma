generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  previewFeatures        = ["partialIndexes"]
}

datasource db {
  provider = "sqlite"
}

model Execution {
  id                String             @id
  controller        Controller?
  guards            Guard[]
  httpErrors        HttpError[]
  interceptors      Interceptor[]
  middlewares       Middleware[]
  nativeMiddlewares NativeMiddleware[]
  pipes             Pipe[]
  request           Request?
  response          Response?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
}

model Controller {
  id           String    @id
  controller   String
  method       String
  error        Json?
  started_at   DateTime
  ended_at     DateTime
  execution_id String    @unique
  execution    Execution @relation(fields: [execution_id], references: [id], onDelete: Cascade)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
}

model Guard {
  id           String    @id
  guard        String
  allowed      Boolean?
  error        Json?
  started_at   DateTime
  ended_at     DateTime
  execution_id String
  execution    Execution @relation(fields: [execution_id], references: [id], onDelete: Cascade)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([execution_id])
}

model HttpError {
  id           String    @id
  error        Json
  filter       String?
  started_at   DateTime
  ended_at     DateTime
  execution_id String
  execution    Execution @relation(fields: [execution_id], references: [id], onDelete: Cascade)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([execution_id])
}

model Interceptor {
  id           String    @id
  interceptor  String
  error        Json?
  started_at   DateTime
  ended_at     DateTime
  execution_id String
  execution    Execution @relation(fields: [execution_id], references: [id], onDelete: Cascade)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([execution_id])
}

model Middleware {
  id           String    @id
  middleware   String
  error        Json?
  phase        String
  started_at   DateTime
  ended_at     DateTime
  execution_id String
  execution    Execution @relation(fields: [execution_id], references: [id], onDelete: Cascade)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([execution_id])
}

model NativeMiddleware {
  id           String    @id
  name         String
  error        Json?
  started_at   DateTime
  ended_at     DateTime
  execution_id String
  execution    Execution @relation(fields: [execution_id], references: [id], onDelete: Cascade)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([execution_id])
}

model Pipe {
  id              String    @id
  pipe            String
  method          String
  parameter_index Int
  error           Json?
  started_at      DateTime
  ended_at        DateTime
  execution_id    String
  execution       Execution @relation(fields: [execution_id], references: [id], onDelete: Cascade)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@index([execution_id])
}

model Request {
  id           String    @id
  headers      Json
  method       String
  started_at   DateTime
  url          String
  execution_id String    @unique
  execution    Execution @relation(fields: [execution_id], references: [id], onDelete: Cascade)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([method])
  @@index([url])
}

model Response {
  id           String    @id
  aborted      Boolean
  headers      Json
  sent_at      DateTime
  status_code  Int
  execution_id String    @unique
  execution    Execution @relation(fields: [execution_id], references: [id], onDelete: Cascade)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([status_code])
}
