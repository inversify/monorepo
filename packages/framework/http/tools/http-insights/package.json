{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/inversify/monorepo/issues"
  },
  "description": "InversifyJs HTTP insights",
  "dependencies": {
    "@babel/parser": "8.0.8",
    "@inversifyjs/http-core": "workspace:*",
    "@inversifyjs/http-insights-ui": "workspace:*",
    "@inversifyjs/http-instrumentation-core": "workspace:*",
    "@inversifyjs/http-validation": "workspace:*",
    "@inversifyjs/prisma": "1.0.0",
    "@inversifyjs/standard-schema-validation": "workspace:*",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-sqlite3": "13.0.3",
    "mime-types": "3.0.2",
    "prisma": "7.10.1",
    "stack-trace": "1.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@inversifyjs/foundation-oxfmt-config": "workspace:*",
    "@inversifyjs/foundation-oxlint-config": "workspace:*",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/mime-types": "3.0.1",
    "@types/node": "24.19.2",
    "@types/stack-trace": "0.0.33",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "node": "^24.10.0",
    "pnpm": "^12.0.0"
  },
  "homepage": "https://inversify.io",
  "keywords": [
    "dependency injection",
    "dependency inversion",
    "di",
    "inversion of control container",
    "ioc",
    "javascript",
    "node",
    "typescript"
  ],
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js"
  },
  "name": "@inversifyjs/http-insights",
  "peerDependencies": {
    "inversify": "^8.2.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inversify/monorepo.git"
  },
  "scripts": {
    "build": "pnpm run db:generate && pnpm run db:generate:migrate && tsc",
    "build:clean": "rimraf lib src/generated",
    "db:generate": "prisma generate",
    "db:generate:migrate": "tsx src/scripts/generatePrismaMigrate.ts",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "pnpm run db:generate:migrate && node --input-type=module -e \"import('./src/generated/prisma-migrate/index.ts').then((m) => m.resetDb())\"",
    "format": "oxfmt --write ./src",
    "lint": "oxlint ./src",
    "prebuild": "pnpm run build:clean",
    "test": "vitest run",
    "test:integration": "pnpm run test --project Integration",
    "test:coverage": "pnpm run test:unit --coverage",
    "test:mutation": "stryker run",
    "test:uncommitted": "pnpm run test --changed=HEAD",
    "test:unit": "pnpm run test --project Unit"
  },
  "type": "module",
  "version": "0.4.0"
}
