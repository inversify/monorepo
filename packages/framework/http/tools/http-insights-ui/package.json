{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/inversify/monorepo/issues"
  },
  "description": "InversifyJS HTTP insights user interface",
  "devEngines": {
    "node": "^24.10.0",
    "pnpm": "^12.0.0"
  },
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "dist",
    "lib",
    "!lib/**/*.spec.js",
    "!lib/**/*.spec.js.map",
    "!lib/**/*.spec.d.ts",
    "!lib/**/*.spec.d.ts.map"
  ],
  "homepage": "https://inversify.io",
  "keywords": [
    "dependency injection",
    "dependency inversion",
    "di",
    "http",
    "insights",
    "inversion of control container",
    "ioc",
    "javascript",
    "node",
    "typescript"
  ],
  "license": "MIT",
  "name": "@inversifyjs/http-insights-ui",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inversify/monorepo.git"
  },
  "scripts": {
    "build": "pnpm run typecheck && pnpm run build:bundle && pnpm run build:node",
    "build:bundle": "vite build",
    "build:clean": "rimraf dist lib tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo",
    "build:node": "tsc -p tsconfig.build.json",
    "dev": "HTTP_INSIGHTS_UI_BASE=/ vite",
    "format": "prettier --write ./src ./index.html ./vite.config.ts",
    "lint": "eslint ./src ./vite.config.ts",
    "prebuild": "pnpm run build:clean",
    "test": "vitest run",
    "test:coverage": "pnpm run test:unit --coverage",
    "test:integration": "pnpm run test --project Integration",
    "test:unit": "pnpm run test --project Unit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "type": "module",
  "version": "0.2.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@inversifyjs/foundation-eslint-config": "workspace:*",
    "@inversifyjs/foundation-prettier-config": "workspace:*",
    "@inversifyjs/foundation-typescript-config": "workspace:*",
    "@tanstack/react-query": "5.104.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "lucide-react": "1.59.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
