{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/inversify/monorepo/issues"
  },
  "description": "InversifyJs http E2E tests package",
  "dependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@hono/node-server": "2.1.6",
    "@inversifyjs/http-core": "workspace:*",
    "@inversifyjs/http-express": "workspace:*",
    "@inversifyjs/http-fastify": "workspace:*",
    "@inversifyjs/http-hono": "workspace:*",
    "@inversifyjs/http-uwebsockets": "workspace:*",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "hono": "^4.13.16",
    "inversify": "8.3.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.70.0"
  },
  "devDependencies": {
    "@fastify/multipart": "10.1.7",
    "@inversifyjs/foundation-oxfmt-config": "workspace:*",
    "@inversifyjs/foundation-oxlint-config": "workspace:*",
    "@types/express": "5.0.6",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "rimraf": "6.1.4",
    "typescript": "7.0.2"
  },
  "homepage": "https://inversify.io",
  "devEngines": {
    "node": "^26.0.0",
    "pnpm": "^12.0.0"
  },
  "license": "MIT",
  "name": "@inversifyjs/http-e2e-tests",
  "private": "true",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inversify/monorepo.git"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rimraf lib",
    "format": "oxfmt --write ./src",
    "lint": "oxlint ./src",
    "prebuild": "pnpm run build:clean",
    "test:e2e": "pnpm run test:e2e:esm",
    "test:e2e:esm": "cucumber-js --config=config/cucumber.config.mjs --profile=serial"
  },
  "type": "module"
}
