# package.json "files" is the pack allowlist (bin, lib, templates). npm pack
# ignores this top-level file when "files" is set; nested ignores still apply
# (see lib/.npmignore). Keep these rules as a fallback if "files" is removed.

/.turbo
/coverage
/docs
/reports
/tmp

**/*.ts
!lib/**/*.d.ts
!templates/**/*.ts
lib/**/fixtures/**
**/*.spec.d.ts
**/*.spec.js
**/*.spec.js.map
**/*.spec.d.ts.map
**/*.spec-d.js
**/*.spec-d.d.ts
**/*.spec-d.js.map
**/*.spec-d.d.ts.map

AGENTS.md
CHANGELOG.md
.lintstagedrc.json
eslint.config.mjs
prettier.config.mjs
tsconfig.esm.json
tsconfig.esm.tsbuildinfo
tsconfig.json
vitest.config.mjs
