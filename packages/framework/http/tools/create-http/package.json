{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/inversify/monorepo/issues"
  },
  "bin": {
    "create-inversify-http": "./bin/create-inversify-http.js"
  },
  "description": "Scaffold an InversifyJS HTTP application",
  "dependencies": {
    "@clack/prompts": "0.11.0",
    "citty": "0.2.2",
    "ts-morph": "28.0.0"
  },
  "devDependencies": {
    "@inversifyjs/eslint-plugin-require-extensions": "workspace:*",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "node": "^24.10.0",
    "pnpm": "^11.0.0"
  },
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "bin",
    "lib",
    "templates"
  ],
  "homepage": "https://inversify.io",
  "keywords": [
    "create",
    "dependency injection",
    "http",
    "inversify",
    "scaffold",
    "typescript"
  ],
  "license": "MIT",
  "name": "@inversifyjs/create-http",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inversify/monorepo.git"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rimraf lib",
    "format": "prettier --write ./src",
    "lint": "eslint ./src",
    "prebuild": "pnpm run build:clean",
    "test": "vitest run",
    "test:coverage": "pnpm run test:unit --coverage",
    "test:integration": "pnpm run test --project Integration",
    "test:uncommitted": "pnpm run test --changed=HEAD",
    "test:unit": "pnpm run test --project Unit"
  },
  "type": "module",
  "version": "0.2.0"
}
