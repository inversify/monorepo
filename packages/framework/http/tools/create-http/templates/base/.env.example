# Environment configuration
# Copy this file to .env and update values as needed

NODE_ENV=development
PORT=3000
# Optional. Set to true to enable HTTP insights. Defaults to false when unset.
DEV_PROFILER_ENABLED=true
# Comma-separated log levels: error,warn,info,http,verbose,debug,silly
LOG_LEVELS=error,warn,info
DATABASE_URL=postgresql://inversify:inversify@localhost:5432/inversify?schema=public
