    "@inversifyjs/http-fastify": "workspace:*",
    "@inversifyjs/http-hono": "workspace:*",
    "@inversifyjs/http-uwebsockets": "workspace:*",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/statuses": "2.0.6",
    "@vitest/coverage-v8": "5.0.5",
    "better-sqlite3": "^13.0.3",
    "fastify": "5.12.7",
    "hono": "4.13.14",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.70.0",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "node": "^24.10.0",
    "pnpm": "^12.0.0"
  },
  "homepage": "https://inversify.io",
  "keywords": [
    "dependency injection",
    "dependency inversion",
    "di",
    "inversion of control container",
    "ioc",
    "javascript",
    "node",
    "typescript"
  ],
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js"
  },
  "name": "@inversifyjs/http-better-auth",
  "peerDependencies": {
    "better-auth": "^1.7.14",
    "inversify": "^8.2.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inversify/monorepo.git"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rimraf lib",
    "format": "oxfmt --write ./src",
    "lint": "oxlint ./src",
    "prebuild": "pnpm run build:clean",
    "test": "vitest run",
    "test:integration": "pnpm run test --project Integration",
    "test:coverage": "pnpm run test:unit --coverage",
    "test:mutation": "stryker run",
    "test:uncommitted": "pnpm run test --changed=HEAD",
    "test:unit": "pnpm run test --project Unit"
  },
  "version": "6.0.3",
  "type": "module"
