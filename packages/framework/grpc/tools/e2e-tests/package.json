{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/inversify/monorepo/issues"
  },
  "description": "InversifyJs gRPC E2E tests package",
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@cucumber/cucumber": "13.3.0",
    "@grpc/grpc-js": "1.14.7",
    "@inversifyjs/grpc-core": "workspace:*",
    "@inversifyjs/grpc-js": "workspace:*",
    "inversify": "8.3.0",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@inversifyjs/foundation-oxfmt-config": "workspace:*",
    "@inversifyjs/foundation-oxlint-config": "workspace:*",
    "@types/node": "26.6.6",
    "grpc-tools": "1.13.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rimraf": "6.1.3",
    "ts-proto": "2.18.3",
    "typescript": "7.0.2"
  },
  "homepage": "https://inversify.io",
  "devEngines": {
    "node": "^26.0.0",
    "pnpm": "^12.0.0"
  },
  "license": "MIT",
  "name": "@inversifyjs/grpc-e2e-tests",
  "private": "true",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inversify/monorepo.git"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rimraf lib",
    "format": "oxfmt --write ./src",
    "lint": "oxlint ./src",
    "prebuild": "pnpm run build:clean",
    "proto:generate": "grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/hero/generated --ts_proto_opt=esModuleInterop=true,importSuffix=.js,outputServices=grpc-js,env=node,useOptionals=none,outputJsonMethods=false,outputClientImpl=false --proto_path=./proto ./proto/hero.proto && oxfmt --write ./src/hero/generated/hero.ts",
    "test:e2e": "pnpm run test:e2e:esm",
    "test:e2e:esm": "cucumber-js --config=config/cucumber.config.mjs --profile=serial"
  },
  "type": "module"
}
