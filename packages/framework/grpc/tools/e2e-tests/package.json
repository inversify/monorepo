{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/inversify/monorepo/issues"
  },
  "description": "InversifyJs gRPC E2E tests package",
  "dependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@grpc/grpc-js": "1.14.5",
    "@inversifyjs/grpc-core": "workspace:*",
    "@inversifyjs/grpc-js": "workspace:*",
    "inversify": "8.2.3",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  },
  "homepage": "https://inversify.io",
  "devEngines": {
    "node": "^24.10.0",
    "pnpm": "^12.0.0"
  },
  "license": "MIT",
  "name": "@inversifyjs/grpc-e2e-tests",
  "private": "true",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inversify/monorepo.git"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rimraf lib",
    "format": "prettier --write ./src",
    "lint": "eslint ./src",
    "prebuild": "pnpm run build:clean",
    "test:e2e": "pnpm run test:e2e:esm",
    "test:e2e:esm": "cucumber-js --config=config/cucumber.config.mjs --profile=serial"
  },
  "type": "module"
}
