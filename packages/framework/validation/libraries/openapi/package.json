{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/inversify/monorepo/issues"
  },
  "description": "InversifyJs HTTP OpenAPI body validation package",
  "dependencies": {
    "@inversifyjs/framework-core": "workspace:*",
    "@inversifyjs/http-core": "workspace:*",
    "@inversifyjs/http-open-api": "workspace:*",
    "@inversifyjs/json-schema-pointer": "workspace:*",
    "@inversifyjs/json-schema-utils": "workspace:*",
    "@inversifyjs/open-api-utils": "workspace:*",
    "@inversifyjs/reflect-metadata-utils": "1.5.0",
    "@inversifyjs/uri": "workspace:*",
    "@inversifyjs/validation-common": "workspace:*"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.5",
    "@inversifyjs/foundation-oxfmt-config": "workspace:*",
    "@inversifyjs/foundation-oxlint-config": "workspace:*",
    "@inversifyjs/http-express": "workspace:*",
    "@inversifyjs/http-fastify": "workspace:*",
    "@inversifyjs/http-hono": "workspace:*",
    "@inversifyjs/json-schema-types": "workspace:*",
    "@inversifyjs/open-api-types": "workspace:*",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "express": "5.3.0",
    "fastify": "5.12.7",
    "hono": "4.13.14",
    "inversify": "8.2.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "node": "^24.10.0",
    "pnpm": "^12.0.0"
  },
  "homepage": "https://inversify.io",
  "keywords": [
    "dependency injection",
    "dependency inversion",
    "di",
    "inversion of control container",
    "ioc",
    "javascript",
    "node",
    "openapi",
    "validation",
    "typescript"
  ],
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./v3Dot1": "./lib/v3Dot1.js",
    "./v3Dot2": "./lib/v3Dot2.js"
  },
  "name": "@inversifyjs/open-api-validation",
  "peerDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inversify/monorepo.git"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rimraf lib",
    "format": "oxfmt --write ./src",
    "lint": "oxlint ./src",
    "prebuild": "pnpm run build:clean",
    "test": "vitest run",
    "test:integration": "pnpm run test --project Integration",
    "test:coverage": "pnpm run test:unit --coverage",
    "test:mutation": "stryker run",
    "test:uncommitted": "pnpm run test --changed=HEAD",
    "test:unit": "pnpm run test --project Unit"
  },
  "version": "3.6.9",
  "type": "module"
}
