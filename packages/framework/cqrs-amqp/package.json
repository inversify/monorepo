{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/inversify/monorepo/issues"
  },
  "description": "InversifyJs framework CQRS AMQP transport package",
  "dependencies": {
    "@inversifyjs/common": "workspace:*",
    "@inversifyjs/logger": "workspace:*",
    "rhea": "3.0.5"
  },
  "devDependencies": {
    "@inversifyjs/foundation-oxfmt-config": "workspace:*",
    "@inversifyjs/framework-cqrs": "workspace:*",
    "@inversifyjs/foundation-oxlint-config": "workspace:*",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "node": "^26.0.0",
    "pnpm": "^12.0.0"
  },
  "homepage": "https://inversify.io",
  "keywords": [
    "amqp",
    "amqp 1.0",
    "dependency injection",
    "dependency inversion",
    "cqrs",
    "di",
    "inversion of control container",
    "ioc",
    "javascript",
    "node",
    "rhea",
    "typescript"
  ],
  "license": "MIT",
  "exports": {
    "./v1Dot0": "./lib/amqp/v1Dot0/index.js"
  },
  "name": "@inversifyjs/framework-cqrs-amqp",
  "peerDependencies": {
    "@inversifyjs/framework-cqrs": "workspace:^",
    "inversify": "^8.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inversify/monorepo.git"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rimraf lib",
    "format": "oxfmt --write ./src",
    "lint": "oxlint ./src",
    "prebuild": "pnpm run build:clean",
    "test": "vitest run",
    "test:integration": "pnpm run test --project Integration",
    "test:coverage": "pnpm run test:unit --coverage",
    "test:mutation": "stryker run",
    "test:uncommitted": "pnpm run test --changed=HEAD",
    "test:unit": "pnpm run test --project Unit"
  },
  "version": "0.0.0",
  "type": "module"
}
