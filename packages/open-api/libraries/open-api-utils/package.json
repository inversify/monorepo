{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/inversify/monorepo/issues"
  },
  "description": "InversifyJs OpenAPI utils package",
  "dependencies": {
    "@inversifyjs/json-schema-pointer": "workspace:*",
    "@inversifyjs/json-schema-types": "workspace:*",
    "@inversifyjs/json-schema-utils": "workspace:*",
    "@inversifyjs/uri": "workspace:*"
  },
  "devDependencies": {
    "@inversifyjs/foundation-oxfmt-config": "workspace:*",
    "@inversifyjs/foundation-oxlint-config": "workspace:*",
    "@inversifyjs/open-api-types": "workspace:*",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "rimraf": "6.1.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "homepage": "https://inversify.io",
  "keywords": [
    "oas",
    "openapi",
    "utils"
  ],
  "devEngines": {
    "node": "^26.0.0",
    "pnpm": "^12.0.0"
  },
  "license": "MIT",
  "exports": {
    "./v3Dot1": "./lib/openApi/v3Dot1/index.js",
    "./v3Dot2": "./lib/openApi/v3Dot2/index.js"
  },
  "name": "@inversifyjs/open-api-utils",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inversify/monorepo.git"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rimraf lib",
    "format": "oxfmt --write ./src",
    "lint": "oxlint ./src",
    "prebuild": "pnpm run build:clean",
    "test": "vitest run",
    "test:integration": "pnpm run test --project Integration",
    "test:coverage": "pnpm run test:unit --coverage",
    "test:mutation": "stryker run",
    "test:uncommitted": "pnpm run test --changed=HEAD",
    "test:unit": "pnpm run test --project Unit"
  },
  "version": "0.3.2",
  "type": "module"
}
